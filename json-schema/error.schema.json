{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jogjatrip.example/schemas/error.schema.json",
  "title": "Error",
  "type": "object",
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{1,60}$"
    },
    "message": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "Every non-2xx answer. `code` is stable and machine-readable; `message` is for people."
}