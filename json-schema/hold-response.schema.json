{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jogjatrip.example/schemas/hold-response.schema.json",
  "title": "Hold",
  "type": "object",
  "required": [
    "holdId",
    "offerId",
    "externalRef",
    "reservationState",
    "paymentState",
    "totalPrice",
    "currency",
    "expiresAt"
  ],
  "properties": {
    "holdId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "offerId": {
      "type": "string"
    },
    "externalRef": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "hotel",
        "wisata",
        "transport"
      ]
    },
    "resourceId": {
      "type": "string"
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "quantity": {
      "type": "integer"
    },
    "reservationState": {
      "type": "string",
      "enum": [
        "awaiting_payment",
        "reserved",
        "cancelled",
        "expired"
      ]
    },
    "paymentState": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded",
        "partially_refunded",
        "expired",
        "not_applicable"
      ]
    },
    "fulfillmentState": {
      "type": "string",
      "description": "Provider-owned; informational."
    },
    "totalPrice": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "const": "IDR"
    },
    "priceType": {
      "type": "string",
      "const": "SIMULATED"
    },
    "simulation": {
      "type": "boolean"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Hold deadline. May be null once the hold is reserved or cancelled."
    },
    "voucher": {
      "type": "object",
      "required": [
        "code",
        "note"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "reservationState": {
            "const": "reserved"
          }
        },
        "required": [
          "reservationState"
        ]
      },
      "then": {
        "required": [
          "voucher"
        ]
      }
    }
  ]
}